<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>
        <!-- In-memory H2 для тестов -->
        <property name="hibernate.connection.driver_class">org.h2.Driver</property>
        <property name="hibernate.connection.url">jdbc:h2:mem:testdb;DB_CLOSE_DELAY=-1;MODE=PostgreSQL</property>
        <property name="hibernate.connection.username">sa</property>
        <property name="hibernate.connection.password"></property>

        <property name="hibernate.dialect">org.hibernate.dialect.H2Dialect</property>
        <property name="hibernate.show_sql">false</property> <!-- для тестов выключим -->
        <property name="hibernate.format_sql">false</property>

        <!-- Для тестов используем create-drop -->
        <property name="hibernate.hbm2ddl.auto">create-drop</property>

        <!-- Важно для корректной работы с H2 -->
        <property name="hibernate.jdbc.batch_size">20</property>
        <property name="hibernate.order_inserts">true</property>
        <property name="hibernate.order_updates">true</property>

        <!-- Маппинги сущностей -->
        <mapping class="ru.job4j.cars.model.Car"/>
        <mapping class="ru.job4j.cars.model.Engine"/>
        <mapping class="ru.job4j.cars.model.Owner"/>
        <mapping class="ru.job4j.cars.model.Participates"/>
        <mapping class="ru.job4j.cars.model.Post"/>
        <mapping class="ru.job4j.cars.model.PriceHistory"/>
        <mapping class="ru.job4j.cars.model.User"/>
    </session-factory>
</hibernate-configuration>