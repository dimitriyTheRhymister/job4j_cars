<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <!-- Все DDL в одном файле -->
    <changeSet id="1" author="system">
        <sqlFile path="sql/ddl_combined.sql" relativeToChangelogFile="true"/>
    </changeSet>

    <!-- Все DML в одном файле -->
    <changeSet id="2" author="system">
        <sqlFile path="sql/dml_combined.sql" relativeToChangelogFile="true"/>
    </changeSet>

</databaseChangeLog>